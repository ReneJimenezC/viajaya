# Plantilla de variables de entorno. Se sube a Git SIN secretos reales.
# Uso: copiar este archivo como ".env" en la misma carpeta y cambiar los valores.

# Entorno de ejecución: development, production o test
NODE_ENV=development

# Puerto en el que escucha la API (Render lo define solo en producción)
PORT=3000

# Credenciales del Postgres de desarrollo (contenedor "db" de docker-compose)
POSTGRES_USER=viajaya
# Usar solo letras y números: los símbolos (@ : / #) rompen la URL de abajo
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=viajaya

# URL de conexión para correr la API fuera de Docker (npm run dev).
# Debe repetir el usuario, la clave y la base de arriba. Host = localhost.
# Dentro de Docker, docker-compose arma su propia URL con host "db".
# En producción será la URL de Supabase.
DATABASE_URL=postgresql://viajaya:...@127.0.0.1:5432/viajaya

# Secreto para firmar los access tokens (JWT) del administrador.
# Mínimo 32 caracteres: la API NO arranca con uno más corto (como este de ejemplo, a propósito).
# Generar uno con: node -p "require('crypto').randomBytes(48).toString('base64url')"
# Usar uno distinto en cada entorno (desarrollo y producción) y nunca subirlo a Git.
JWT_SECRET=cambiar_por_un_secreto_generado


# --- Solo para crear el administrador (npm run seed:admin) ---
# La API NO las usa. Descomentar, ejecutar el seed una vez y BORRAR estas líneas.
# Contraseña: 12 a 128 caracteres, ENTRE COMILLAS SIMPLES (sin un # dentro se cortaría)
# y sin usar el carácter ' (comilla simple).
# ADMIN_EMAIL=admin@ejemplo.com
# ADMIN_PASSWORD='una frase larga y segura'