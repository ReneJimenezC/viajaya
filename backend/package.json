{
  "name": "viajaya-backend",
  "version": "0.1.0",
  "description": "API REST del sistema de reservas turísticas ViajaYa",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts | pino-pretty --translateTime SYS:HH:MM:ss --ignore pid,hostname",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/tests/**/*.test.ts\"",
    "migration:run": "tsx --env-file=../.env ./node_modules/typeorm/cli.js migration:run -d src/config/data-source.ts",
    "migration:revert": "tsx --env-file=../.env ./node_modules/typeorm/cli.js migration:revert -d src/config/data-source.ts",
    "migration:show": "tsx --env-file=../.env ./node_modules/typeorm/cli.js migration:show -d src/config/data-source.ts",
    "seed:dev": "tsx --env-file=../.env src/seeds/dev-seed.ts",
    "seed:admin": "tsx --env-file=../.env src/seeds/admin-seed.ts"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
